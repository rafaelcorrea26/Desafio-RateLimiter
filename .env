WEB_SERVER_PORT=8080

# limites em requisições por segundo
RATE_LIMIT_IP=10
RATE_LIMIT_TOKEN=100
# limites específicos por token (token:limite separados por vírgula)
RATE_LIMIT_TOKENS=abc123:100,xyz789:50

# tempo de bloqueio em segundos depois de estourar o limite
BLOCK_DURATION=300

# redis ou memory
LIMITER_STORAGE=redis

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
